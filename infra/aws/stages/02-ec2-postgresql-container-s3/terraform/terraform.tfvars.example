aws_region       = "us-east-1"
project_name     = "shopmicro"
environment      = "stage-02"
marketplace_cidr = "0.0.0.0/0"
# Abra https://checkip.amazonaws.com/ no navegador e copie o IPv4 exibido.
# Substitua seu_ip pelo valor encontrado e mantenha o /32 para liberar somente seu acesso.
# Exemplo: IP exibido 203.0.113.10 -> admin_cidr = "203.0.113.10/32"
admin_cidr        = "seu_ip/32"
instance_type     = "t3.small"
root_volume_size  = 8
repository_url    = "https://github.com/d3v0psti/shopmicro.git"
repository_branch = "develop"

# true facilita o terraform destroy neste estágio e apaga os objetos do bucket.
force_destroy_bucket = true
