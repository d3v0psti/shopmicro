# PostgreSQL local
POSTGRES_DB=shopdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST_PORT=5432

# Backend
ASPNETCORE_ENVIRONMENT=Development
# Gere um segredo aleatório conforme as instruções do README.
JWT_SECRET=
CORS_ALLOWED_ORIGINS=*
ENABLE_SWAGGER=true
STORAGE_PROVIDER=Local
BACKEND_HOST_PORT=8080

# Bootstrap da primeira conta administrativa.
# Este bloco só é usado quando a tabela administrative_accounts está vazia.
# Depois da criação, alterações aqui não modificam a conta existente.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_FULL_NAME=Administrador inicial

# Frontends locais
BACKEND_UPSTREAM=http://shopmicro-backend:8080
MARKETPLACE_HOST_PORT=80
ADMIN_HOST_PORT=81
