server {
    listen 80;
    server_name localhost;

    root /usr/share/nginx/html;
    index index.html index.htm;

    # Health checks — usados pelas probes do Kubernetes (liveness/readiness)
    # e por qualquer load balancer, em qualquer nuvem ou on-premises.
    location /health/live {
        access_log off;
        return 200 'ok';
        add_header Content-Type text/plain;
    }

    location /health/ready {
        access_log off;
        return 200 'ok';
        add_header Content-Type text/plain;
    }

    # Rota principal: se for a página, tenta achar o arquivo ou cai no index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Arquivos estáticos (CSS, JS, imagens)
    location ~* \.(css|js|ico|png|jpg|jpeg|gif|svg|woff|woff2|ttf|eot)$ {
        try_files $uri =404;
        expires 1d;
        access_log off;
    }

    # Proxy reverso para o backend.
    # BACKEND_UPSTREAM é substituído em tempo de execução (envsubst, nativo
    # da imagem oficial do Nginx) — em Docker Compose aponta para o nome do
    # serviço ("backend"), em Kubernetes para o nome do Service
    # ("backend-service"), sem precisar de rebuild da imagem.
    location /api/ {
        proxy_pass ${BACKEND_UPSTREAM};

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }
}
